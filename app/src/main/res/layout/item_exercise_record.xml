<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.HealthApp.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/exercise_gap_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/exercise_record_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_exercise_record_name"
                    style="@style/TextAppearance.HealthApp.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="@dimen/exercise_record_name_max_width" />

                <ImageView
                    android:id="@+id/image_exercise_record_icon"
                    android:layout_width="@dimen/exercise_record_icon_size"
                    android:layout_height="@dimen/exercise_record_icon_size"
                    android:layout_marginStart="@dimen/exercise_record_icon_gap"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_exercise_record_details"
                style="@style/TextAppearance.HealthApp.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/exercise_gap_tiny" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_exercise_record_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exercise_delete_confirm"
            android:textColor="@color/health_accent_red" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
