<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.HealthApp.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/diet_food_grid_gap"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/diet_food_item_padding">

        <ImageView
            android:id="@+id/image_food_picker"
            android:layout_width="@dimen/diet_food_image_size"
            android:layout_height="@dimen/diet_food_image_size"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/text_food_picker_name"
            style="@style/TextAppearance.HealthApp.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:id="@+id/text_food_picker_calories"
            style="@style/TextAppearance.HealthApp.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/diet_food_text_gap"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="@dimen/diet_food_calorie_text_size" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
