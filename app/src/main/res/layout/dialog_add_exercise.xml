<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/TextAppearance.HealthApp.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/exercise_label_select" />

    <Spinner
        android:id="@+id/spinner_exercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        style="@style/TextAppearance.HealthApp.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/exercise_label_minutes" />

    <EditText
        android:id="@+id/input_exercise_minutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/exercise_hint_minutes"
        android:importantForAutofill="no"
        android:inputType="number" />

    <TextView
        android:id="@+id/text_exercise_estimate"
        style="@style/TextAppearance.HealthApp.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/exercise_kcal_unknown" />
</LinearLayout>
