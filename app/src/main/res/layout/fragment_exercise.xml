<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/exercise_page_padding">

        <TextView
            style="@style/TextAppearance.HealthApp.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exercise_page_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/exercise_gap_large"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HealthApp.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/exercise_gap_small"
                android:layout_weight="1"
                android:minHeight="@dimen/exercise_stat_card_min_height">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/exercise_card_padding">

                    <TextView
                        style="@style/TextAppearance.HealthApp.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exercise_today_duration" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_exercise_today_minutes_value"
                            style="@style/TextAppearance.HealthApp.BigNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_value_unavailable" />

                        <TextView
                            style="@style/TextAppearance.HealthApp.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/exercise_gap_tiny"
                            android:layout_marginBottom="@dimen/exercise_unit_bottom_margin"
                            android:text="@string/exercise_unit_min" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_exercise_today_minutes_state"
                        style="@style/TextAppearance.HealthApp.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exercise_loading" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HealthApp.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/exercise_gap_small"
                android:layout_weight="1"
                android:minHeight="@dimen/exercise_stat_card_min_height">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/exercise_card_padding">

                    <TextView
                        style="@style/TextAppearance.HealthApp.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exercise_today_calories" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_exercise_today_calories_value"
                            style="@style/TextAppearance.HealthApp.BigNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_value_unavailable" />

                        <TextView
                            style="@style/TextAppearance.HealthApp.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/exercise_gap_tiny"
                            android:layout_marginBottom="@dimen/exercise_unit_bottom_margin"
                            android:text="@string/exercise_unit_kcal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_exercise_today_calories_state"
                        style="@style/TextAppearance.HealthApp.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exercise_loading" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HealthApp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/exercise_gap_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/exercise_card_padding">

                <TextView
                    style="@style/TextAppearance.HealthApp.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exercise_week_title" />

                <TextView
                    android:id="@+id/text_exercise_week_summary"
                    style="@style/TextAppearance.HealthApp.CardValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/exercise_gap_tiny"
                    android:text="@string/exercise_week_loading" />

                <TextView
                    android:id="@+id/text_exercise_week_goal_value"
                    style="@style/TextAppearance.HealthApp.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/exercise_gap_tiny"
                    android:text="@string/exercise_week_goal_loading" />

                <LinearLayout
                    android:id="@+id/container_exercise_week_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/exercise_gap_medium"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/text_exercise_week_state"
                    style="@style/TextAppearance.HealthApp.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/exercise_gap_small"
                    android:text="@string/exercise_week_records_note" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HealthApp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/exercise_gap_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/exercise_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.HealthApp.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/exercise_records_title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_exercise_record_date"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/exercise_compact_button_height"
                        android:text="@string/exercise_date_today_short" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_exercise_records_state"
                    style="@style/TextAppearance.HealthApp.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/exercise_gap_medium"
                    android:text="@string/exercise_records_loading" />

                <LinearLayout
                    android:id="@+id/container_exercise_records"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_exercise_add_record"
            style="@style/Widget.HealthApp.Button.Red"
            android:layout_width="match_parent"
            android:layout_height="@dimen/exercise_primary_button_height"
            android:layout_marginTop="@dimen/exercise_gap_large"
            android:layout_marginBottom="@dimen/exercise_gap_large"
            android:text="@string/exercise_add_record" />
    </LinearLayout>
</ScrollView>
