<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.HealthApp.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_title_v2" />

            <!-- 资料不完整提示：点击跳转资料页，资料完整后自动消失 -->
            <TextView
                android:id="@+id/text_home_profile_hint"
                style="@style/TextAppearance.HealthApp.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/home_profile_incomplete_hint"
                android:textColor="@color/health_accent_blue"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_home_date"
            style="@style/TextAppearance.HealthApp.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- 小猫状态块（替代风格稿黄色大卡）：白底粗黑边框 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HealthApp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_home_status"
                    style="@style/TextAppearance.HealthApp.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_status_no_record" />

                <TextView
                    android:id="@+id/text_home_pet_earned"
                    style="@style/TextAppearance.HealthApp.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_cat_pet_status_gap"
                    android:gravity="center"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/home_cat_pet_count_loading" />

                <!-- 挂载点 id 冻结：E 的小猫动画替换此容器内容 -->
                <FrameLayout
                    android:id="@+id/container_home_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.example.healthapp.home.pet.PetView
                        android:id="@+id/image_home_cat"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_cat_pet_height"
                        android:layout_gravity="center"
                        android:contentDescription="@string/home_cat_pet_desc" />
                </FrameLayout>

                <TextView
                    android:id="@+id/text_home_pet_status"
                    style="@style/TextAppearance.HealthApp.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_cat_pet_status_gap"
                    android:gravity="center"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/home_cat_pet_loading" />

                <TextView
                    android:id="@+id/text_home_net_line"
                    style="@style/TextAppearance.HealthApp.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 运动 / 摄入 双栏 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HealthApp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.HealthApp.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exercise_today_minutes" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_home_minutes"
                            style="@style/TextAppearance.HealthApp.BigNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            style="@style/TextAppearance.HealthApp.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/home_minutes_unit" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="64dp"
                    android:background="@color/health_outline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.HealthApp.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_grid_intake" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_home_intake"
                            style="@style/TextAppearance.HealthApp.BigNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            style="@style/TextAppearance.HealthApp.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/home_kcal_unit" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 今日任务 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HealthApp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/container_home_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.HealthApp.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_task_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
