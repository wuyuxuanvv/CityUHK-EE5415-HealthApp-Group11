<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.HealthApp.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/exercise_gap_small"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/exercise_search_result_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_exercise_search_result_name"
                style="@style/TextAppearance.HealthApp.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/text_exercise_search_result_details"
                style="@style/TextAppearance.HealthApp.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/exercise_gap_tiny" />
        </LinearLayout>

        <ImageView
            android:id="@+id/image_exercise_search_result_icon"
            android:layout_width="@dimen/exercise_search_icon_size"
            android:layout_height="@dimen/exercise_search_icon_size"
            android:layout_marginStart="@dimen/exercise_gap_medium"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
