<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="2dp">

    <TextView android:id="@+id/text_diet_week_day_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/text_diet_week_day_label" style="@style/TextAppearance.HealthApp.Body"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/text_diet_week_day_date" style="@style/TextAppearance.HealthApp.Body"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
