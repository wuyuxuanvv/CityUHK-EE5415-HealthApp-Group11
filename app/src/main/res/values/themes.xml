<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HealthApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/health_primary</item>
        <item name="colorOnPrimary">@color/health_on_primary</item>
        <item name="colorPrimaryContainer">@color/health_primary_container</item>
        <item name="android:colorBackground">@color/health_background</item>
        <item name="colorSurface">@color/health_surface</item>
        <item name="android:navigationBarColor">@color/health_surface</item>
        <item name="android:statusBarColor">@color/health_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.HealthApp.Button</item>
    </style>

    <!-- 新粗野主义卡片：白底、纯黑粗边框、直角、无圆角 -->
    <style name="Widget.HealthApp.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/health_surface</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/health_outline</item>
        <item name="strokeWidth">2.5dp</item>
    </style>

    <!-- 新粗野主义按钮：纯黑底、白字、粗体、直角黑边 -->
    <style name="Widget.HealthApp.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/health_primary</item>
        <item name="android:textColor">@color/health_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">@color/health_primary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- 底部导航选中指示块：黄色直角 -->
    <style name="Widget.HealthApp.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/health_primary_container</item>
    </style>

    <!-- 蓝色主按钮（风格稿：首页"开始运动"） -->
    <style name="Widget.HealthApp.Button.Blue" parent="Widget.HealthApp.Button">
        <item name="backgroundTint">@color/health_accent_blue</item>
        <item name="strokeColor">@color/health_accent_blue</item>
    </style>

    <!-- 红色主按钮（风格稿：运动页"开始运动"） -->
    <style name="Widget.HealthApp.Button.Red" parent="Widget.HealthApp.Button">
        <item name="backgroundTint">@color/health_accent_red</item>
        <item name="strokeColor">@color/health_accent_red</item>
    </style>

    <!-- 巨型数字（风格稿：32 分钟 / 1,480 千卡） -->
    <style name="TextAppearance.HealthApp.BigNumber" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/health_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthApp.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/health_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthApp.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/health_text_secondary</item>
    </style>

    <style name="TextAppearance.HealthApp.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/health_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthApp.CardValue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/health_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthApp.Placeholder" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/health_text_secondary</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
